# Copy to .env and fill in ONE of the three setups below. Never commit .env.

# Which provider to use: anthropic | bedrock | openai
LLM_PROVIDER=anthropic

# ---- Setup A: Anthropic (default; model names are built in, only the key is needed) ----
ANTHROPIC_API_KEY=

# ---- Setup B: AWS Bedrock (uses your AWS profile/credentials, no key here) ----
# Set LLM_PROVIDER=bedrock above, then uncomment. Model ids are examples that work in ap-south-1; your
# account must have access to them (check: aws bedrock list-foundation-models).
# AWS_REGION=ap-south-1
# BEDROCK_PLANNER_MODEL=qwen.qwen3-235b-a22b-2507-v1:0
# BEDROCK_WRITER_MODEL=moonshotai.kimi-k2.5
# BEDROCK_CRITIC_MODEL=qwen.qwen3-235b-a22b-2507-v1:0
# BEDROCK_EXTRACTOR_MODEL=qwen.qwen3-235b-a22b-2507-v1:0

# ---- Setup C: OpenAI (set all four model names) ----
# Set LLM_PROVIDER=openai above, then uncomment and fill in.
# OPENAI_API_KEY=
# OPENAI_PLANNER_MODEL=
# OPENAI_WRITER_MODEL=
# OPENAI_CRITIC_MODEL=
# OPENAI_EXTRACTOR_MODEL=

# ---- Optional (defaults shown) ----
# Costs come from pricing.json; add a line there if you use a model that is not listed, or it is costed at $0.
# MAX_RUN_COST_USD=0        # total spend limit for a run in USD; 0 = no limit
# MAX_EPISODE_COST_USD=0.50 # spend limit per draft attempt
# MAX_REVISIONS=2           # automatic rewrites before the draft goes to you
# LLM_TIMEOUT_SECONDS=120   # per-request limit; a stuck call is cut off and retried
